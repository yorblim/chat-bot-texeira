# Auto-detect text files and normalize line endings on checkout/commit
* text=auto

# Explicitly declare text files you want to always be normalized and converted to native line endings on checkout
*.py text eol=lf
*.json text eol=lf
*.md text eol=lf
*.yml text eol=lf
*.yaml text eol=lf
*.txt text eol=lf

# Windows scripts
*.bat text eol=crlf
*.cmd text eol=crlf
*.ps1 text eol=crlf

# Binary files
*.db binary
*.sqlite binary
*.sqlite3 binary
*.bin binary
*.png binary
*.jpg binary
*.jpeg binary
*.webp binary
*.pdf binary
