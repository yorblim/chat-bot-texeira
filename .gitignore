# =============================================
# .gitignore - Chat Bot Texeira
# =============================================

# ---- SECRETOS Y CREDENCIALES (NUNCA subir) ----
.env
.env.*
!.env.example
*.env
secrets.py
config_secret*
token*.txt
*_token.txt
phone_id.txt
wa_number_id.txt
WABA_ID.txt

# ---- Python ----
__pycache__/
*.py[cod]
*$py.class
*.pyc
*.pyo
*.pyd
.Python
env/
venv/
.venv/
ENV/
env.bak/
venv.bak/
pip-log.txt
pip-delete-this-directory.txt
.eggs/
*.egg-info/
dist/
build/
*.egg
*.whl

# ---- Logs ----
*.log
logs/
wa_output.log
wa_error.log

# ---- Archivos temporales ----
tmp/
temp/
*.tmp
*.bak
*.swp
*.swo
*~
.DS_Store
Thumbs.db
desktop.ini

# ---- IDEs ----
.vscode/settings.json
.idea/
*.iml
.project
.classpath

# ---- Comprimidos ----
*.tar.gz
*.zip
*.rar

# ---- Respaldos locales ----
respaldos/

# ---- Node (si aplica) ----
node_modules/
npm-debug.log*
yarn-debug.log*

# ---- Jupyter ----
.ipynb_checkpoints/
*.ipynb

# ---- Base de datos local y estado en ejecucion ----
*.db
*.sqlite
*.sqlite3
state/
**/state/

# ---- Cache de Pruebas y Cobertura ----
.pytest_cache/
.coverage
htmlcov/
.ruff_cache/

# ---- Versiones archivadas no rastreadas ----
versiones_anteriores/privacy-stage/
versiones_anteriores/texeira-privacidad/

# ---- Resultados temporales de pruebas locales ----
AUDIT_*.json
RESULTADO_*.json
EVALUATION_*.json


