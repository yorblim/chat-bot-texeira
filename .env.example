# ============================================================
# PLANTILLA DE CONFIGURACIÓN (.env.example) — TEXEIRA TRAVEL TOUR
# ============================================================
# INSTRUCCIONES:
# 1. Copia este archivo como '.env' en la raíz o dentro de 'texeira-prueba-v4-evidencias/'.
# 2. Rellena las variables con tus credenciales y configuración deseadas.
# 3. NUNCA subas el archivo '.env' real a GitHub (está protegido en .gitignore).
# ============================================================

# ------------------------------------------------------------
# 1. PROVEEDOR Y MODELO LLM (RAG)
# ------------------------------------------------------------
# Opciones admitidas: "groq" (recomendado por velocidad/costo), "openai", "anthropic", "deepseek"
LLM_PROVIDER=groq
LLM_MODEL=llama-3.3-70b-versatile

# Claves de API del proveedor (rellena la que corresponda a LLM_PROVIDER):
GROQ_API_KEY=gsk_tu_clave_groq_aqui
OPENAI_API_KEY=sk-proj-tu_clave_openai_aqui
ANTHROPIC_API_KEY=sk-ant-tu_clave_anthropic_aqui
DEEPSEEK_API_KEY=sk-tu_clave_deepseek_aqui

# ------------------------------------------------------------
# 2. META CLOUD API (WHATSAPP BUSINESS)
# ------------------------------------------------------------
# Habilitar integración de WhatsApp en local o nube (true / false)
TEXEIRA_ENABLE_WHATSAPP=true

# Token de verificación personalizado para el Webhook de Meta Developer Console
META_VERIFY_TOKEN=tu_token_de_verificacion_secreto_aqui

# Token de acceso de usuario del sistema (System User Token permanente con permisos whatsapp_business_messaging)
META_ACCESS_TOKEN=EAAG...tu_token_permanente_aqui

# ID de la cuenta de WhatsApp Business (WABA ID) y Phone Number ID oficial
META_PHONE_NUMBER_ID=100000000000000
META_APP_SECRET=tu_app_secret_de_meta_aqui

# Modo de pruebas con identificadores Meta (Sandbox BSUID Map)
WHATSAPP_TEST_MODE=false
WHATSAPP_TEST_BSUID_MAP=

# ------------------------------------------------------------
# 3. META MESSENGER (FACEBOOK)
# ------------------------------------------------------------
# Habilitar integración de Messenger (true / false)
TEXEIRA_ENABLE_MESSENGER=false
FB_PAGE_ACCESS_TOKEN=
FB_APP_SECRET=

# ------------------------------------------------------------
# 4. DERIVACIÓN A ASESORES HUMANOS (HANDOFF)
# ------------------------------------------------------------
# Teléfono del asesor asignado para recibir alertas de tickets y reservas complejas
ADVISOR_WHATSAPP_PHONE=51984000000
TEXEIRA_ENABLE_ADVISOR_NOTIFICATIONS=false

# ------------------------------------------------------------
# 5. SEGURIDAD Y PANELES ADMINISTRATIVOS
# ------------------------------------------------------------
# Credenciales para HTTP Basic Auth (/dashboard, /handoffs, /metrics)
ADMIN_USER=admin
ADMIN_PASSWORD=cambia_esta_contrasena_segura_2026

# ------------------------------------------------------------
# 6. RUTAS DEL SISTEMA Y ALMACENAMIENTO DE ESTADO
# ------------------------------------------------------------
# Directorio donde se guardan bases de datos SQLite locales de interacciones y tickets
TEXEIRA_STATE_DIR=./state

# Índice vectorial ChromaDB activo (por defecto utiliza chroma_f1_confirmado_20260915_db)
CHROMA_HYBRID_DIR=./chroma_f1_confirmado_20260915_db

# ------------------------------------------------------------
# 7. ENTORNO DEL SERVIDOR Y DESPLIEGUE (CLOUD RUN)
# ------------------------------------------------------------
ALLOW_CLOUD_RUN=0
PORT=8021
APP_BASE_URL=http://127.0.0.1:8021
