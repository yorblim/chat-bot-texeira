# ============================================================
# CONFIGURACIÓN DEL AGENTE RAG - TEXEIRA TRAVEL TOUR
# ============================================================
# Copia este archivo como .env y rellena tus claves reales.
# Nunca commitees el .env al repositorio.

# --- Proveedor de LLM ---
# Valores aceptados: "openai", "anthropic", "deepseek" o "groq"
LLM_PROVIDER=openai

# --- Claves de API (solo necesitas la del proveedor elegido) ---
OPENAI_API_KEY=sk-tu-clave-openai-aqui
ANTHROPIC_API_KEY=sk-ant-tu-clave-anthropic-aqui
DEEPSEEK_API_KEY=sk-tu-clave-deepseek-aqui
GROQ_API_KEY=gsk_tu-api-key-de-groq-aqui

# --- Modelo del LLM ---
# OpenAI: gpt-4o-mini, gpt-4o, gpt-3.5-turbo
# Anthropic: claude-3-5-sonnet-20241022, claude-3-haiku-20240307
# DeepSeek: deepseek-chat
# Groq: qwen/qwen3.8-27b, openai/gpt-oss-120b, openai/gpt-oss-20b
LLM_MODEL=gpt-4o-mini

# --- ChromaDB (base de vectores para el RAG) ---
CHROMA_PERSIST_DIR=./chroma_db

# --- Directorio de documentos de tours ---
DOCS_DIR=./documentos_tours

# --- SQLite (logs y métricas de interacciones) ---
SQLITE_DB_PATH=./texeira_logs.db

# --- Meta (WhatsApp / Messenger) ---
# Token de verificación del webhook (lo configuras en Meta Developer Console)
META_VERIFY_TOKEN=tu-token-de-verificacion-meta-aqui
# Token de acceso para enviar respuestas vía WhatsApp Business API / Messenger
META_ACCESS_TOKEN=tu-token-de-acceso-meta-aqui
# Secreto de la app de Meta para validar firmas del webhook
META_APP_SECRET=tu-app-secret-meta-aqui
# ID del número de teléfono de WhatsApp Business
META_PHONE_NUMBER_ID=tu-phone-number-id-aqui

# --- WhatsApp Test Mode (Meta test environment) ---
# Cuando WHATSAPP_TEST_MODE=true, los BSUIDs se resuelven a telefonos via WHATSAPP_TEST_BSUID_MAP
WHATSAPP_TEST_MODE=false
WHATSAPP_TEST_BSUID_MAP=
